# Server
PORT=5000
NODE_ENV=development
# Set FRONTEND_URL to the deployed frontend origin, for example:
# FRONTEND_URL=https://your-frontend.vercel.app
FRONTEND_URL=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL connection string required for Prisma migrations and queries.
# Use Neon's pooled connection string for DATABASE_URL at runtime.
DATABASE_URL=
# Use Neon's direct connection string for Prisma migrations.
DIRECT_URL=

# Persistent profile image storage (Cloudinary).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI provider configuration
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Authentication
JWT_SECRET=
JWT_EXPIRES_IN=1h
